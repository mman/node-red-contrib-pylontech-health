[
  {
    "id": "pyl-tab",
    "type": "tab",
    "label": "Pylontech health",
    "disabled": false,
    "info": "Polls the Pylontech stack every minute and writes cell/battery/stack points to InfluxDB.\nConfigure the influxdb config node (server URL, token/credentials, database) before deploying."
  },
  {
    "id": "pyl-inject",
    "type": "inject",
    "z": "pyl-tab",
    "name": "every 60 s",
    "props": [{ "p": "payload" }],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": "10",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 120,
    "wires": [["pyl-node"]]
  },
  {
    "id": "pyl-refresh",
    "type": "inject",
    "z": "pyl-tab",
    "name": "poll + refresh barcodes",
    "props": [{ "p": "payload" }, { "p": "refresh", "v": "true", "vt": "bool" }],
    "repeat": "",
    "once": false,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 170,
    "y": 180,
    "wires": [["pyl-node"]]
  },
  {
    "id": "pyl-raw",
    "type": "inject",
    "z": "pyl-tab",
    "name": "raw: pwr",
    "props": [{ "p": "command", "v": "pwr", "vt": "str" }],
    "repeat": "",
    "once": false,
    "topic": "",
    "x": 130,
    "y": 240,
    "wires": [["pyl-node"]]
  },
  {
    "id": "pyl-node",
    "type": "pylontech-health",
    "z": "pyl-tab",
    "name": "",
    "port": "/dev/ttyPYLON",
    "baud": 115200,
    "wakeup": true,
    "chain": 1,
    "measurementPrefix": "pylontech",
    "cellIndexBase": 1,
    "includeStates": true,
    "readSoh": false,
    "refreshInfoEvery": 60,
    "commandTimeout": 3000,
    "pollTimeout": 30000,
    "x": 420,
    "y": 160,
    "wires": [["pyl-influx"], ["pyl-debug"]]
  },
  {
    "id": "pyl-influx",
    "type": "influxdb batch",
    "z": "pyl-tab",
    "influxdb": "pyl-influx-cfg",
    "precision": "ms",
    "retentionPolicy": "",
    "name": "influx batch",
    "database": "database",
    "precisionV18FluxV20": "ms",
    "retentionPolicyV18Flux": "",
    "org": "organisation",
    "bucket": "bucket",
    "x": 690,
    "y": 120,
    "wires": []
  },
  {
    "id": "pyl-debug",
    "type": "debug",
    "z": "pyl-tab",
    "name": "health model",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "true",
    "x": 690,
    "y": 200,
    "wires": []
  },
  {
    "id": "pyl-influx-cfg",
    "type": "influxdb",
    "hostname": "127.0.0.1",
    "port": "8086",
    "protocol": "http",
    "database": "venus",
    "name": "influx",
    "usetls": false,
    "tls": "",
    "influxdbVersion": "1.x",
    "url": "http://127.0.0.1:8086",
    "timeout": "10",
    "rejectUnauthorized": true
  }
]
