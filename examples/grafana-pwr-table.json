{
  "kind": "Panel",
  "spec": {
    "id": 19,
    "title": "pwr",
    "description": "",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "influxdb",
                "datasource": {
                  "name": "datasource-influxdb"
                },
                "spec": {
                  "query": "SELECT \"voltage\" AS \"Volt\", \"current\" AS \"Curr\", \"temperature\" AS \"Tempr\",\n       \"temp_low\" AS \"Tlow\", \"temp_low_index\" AS \"Tlow.Id\",\n       \"temp_high\" AS \"Thigh\", \"temp_high_index\" AS \"Thigh.Id\",\n       \"volt_low\" AS \"Vlow\", \"volt_low_index\" AS \"Vlow.Id\",\n       \"volt_high\" AS \"Vhigh\", \"volt_high_index\" AS \"Vhigh.Id\",\n       \"base_state\" AS \"Base.St\", \"volt_state\" AS \"Volt.St\",\n       \"curr_state\" AS \"Curr.St\", \"temp_state\" AS \"Temp.St\",\n       \"soc\" AS \"Coulomb\", \"bv_state\" AS \"B.V.St\", \"bt_state\" AS \"B.T.St\",\n       \"mos_temperature\" AS \"MosTempr\", \"mt_state\" AS \"M.T.St\"\nFROM \"pylontech/battery\"\nWHERE $timeFilter\nGROUP BY \"battery\", \"battery_id\"\nORDER BY time DESC LIMIT 1",
                  "rawQuery": true,
                  "resultFormat": "table"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [
          {
            "kind": "Transformation",
            "group": "sortBy",
            "spec": {
              "options": {
                "fields": {},
                "sort": [
                  {
                    "field": "battery_id"
                  }
                ]
              }
            }
          },
          {
            "kind": "Transformation",
            "group": "organize",
            "spec": {
              "options": {
                "excludeByName": {
                  "Time": true,
                  "battery_id": true,
                  "Curr.St": true,
                  "Temp.St": true,
                  "B.V.St": true,
                  "B.T.St": true,
                  "M.T.St": true,
                  "Base.St": true,
                  "Volt.St": true
                },
                "indexByName": {},
                "renameByName": {},
                "includeByName": {}
              }
            }
          }
        ],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "table",
      "version": "13.2.2",
      "spec": {
        "options": {
          "showHeader": true,
          "cellHeight": "sm"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "footer": {
                "reducers": []
              },
              "cellOptions": {
                "type": "auto"
              },
              "inspect": false
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 80,
                  "color": "red"
                }
              ]
            },
            "color": {
              "mode": "thresholds"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byRegexp",
                "options": "^(Volt|Vlow|Vhigh)$",
                "scope": "series"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "volt"
                },
                {
                  "id": "decimals",
                  "value": 3
                }
              ]
            },
            {
              "matcher": {
                "id": "byRegexp",
                "options": "^(Tempr|Tlow|Thigh|MosTempr)$",
                "scope": "series"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "celsius"
                },
                {
                  "id": "decimals",
                  "value": 1
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Coulomb",
                "scope": "series"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Curr",
                "scope": "series"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "amp"
                },
                {
                  "id": "decimals",
                  "value": 1
                }
              ]
            }
          ]
        }
      }
    }
  }
}
