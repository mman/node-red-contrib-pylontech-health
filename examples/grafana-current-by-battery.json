{
  "kind": "Panel",
  "spec": {
    "id": 18,
    "title": "Current by Battery",
    "description": "",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "influxdb",
                "datasource": {
                  "name": "datasource-influxdb"
                },
                "spec": {
                  "query": "SELECT mean(\"current\")\nFROM \"pylontech/battery\"\nWHERE $timeFilter\nGROUP BY time($__interval), \"battery_id\" fill(previous)",
                  "rawQuery": true,
                  "alias": "$tag_battery_id",
                  "resultFormat": "time_series"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "state-timeline",
      "version": "13.2.2",
      "spec": {
        "options": {
          "mergeValues": true,
          "showValue": "never",
          "alignValue": "left",
          "rowHeight": 0.9,
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none",
            "hideZeros": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 0,
              "fillOpacity": 70,
              "spanNulls": false,
              "insertNulls": false,
              "hideFrom": {
