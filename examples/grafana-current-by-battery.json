{
  "kind": "Panel",
  "spec": {
    "id": 9,
    "title": "Pylontech Current by Battery",
    "description": "Charge/discharge current of each battery (pylontech/battery current, positive = charging). Green is idle (within ±1 A). Orange to dark red is charging, deep red above 10 A; light to dark blue is discharging, deep blue below -10 A. Near the top of charge the modules that are still taking current are the ones still filling, the ones that have gone green are full and waiting; the same split at the bottom shows which modules are carrying the load.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "query": {
                "kind": "DataQuery",
                "version": "v0",
                "group": "influxdb",
                "datasource": {
                  "name": "datasource-influxdb"
                },
                "spec": {
                  "alias": "$tag_battery_id",
                  "query": "SELECT mean(\"current\")\nFROM \"pylontech/battery\"\nWHERE $timeFilter\nGROUP BY time($__interval), \"battery_id\" fill(previous)",
                  "rawQuery": true,
                  "resultFormat": "time_series"
                }
              },
              "refId": "A",
              "hidden": false
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "state-timeline",
      "version": "13.2.2",
      "spec": {
        "options": {
          "mergeValues": true,
          "showValue": "never",
          "alignValue": "left",
          "rowHeight": 0.9,
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none",
            "hideZeros": false
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "lineWidth": 0,
              "fillOpacity": 70,
              "spanNulls": false,
              "insertNulls": false,
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "axisPlacement": "auto"
            },
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "dark-blue"
                },
                {
                  "value": -10,
                  "color": "blue"
                },
                {
                  "value": -5,
                  "color": "light-blue"
                },
                {
                  "value": -2,
                  "color": "super-light-blue"
                },
                {
                  "value": -1,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "super-light-orange"
                },
                {
                  "value": 2,
                  "color": "orange"
                },
                {
                  "value": 5,
                  "color": "red"
                },
                {
                  "value": 10,
                  "color": "dark-red"
                }
              ]
            },
            "unit": "amp",
            "decimals": 1
          },
          "overrides": []
        }
      }
    }
  }
}
