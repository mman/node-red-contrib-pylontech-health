  {
    "id": "dvcc-calc",
    "type": "function",
    "z": "dvcc-tab",
    "name": "taper calc",
    "func": "var MAX_AMPS = 150;    // full rate (6 modules × 25 A)\nvar MIN_AMPS = 5;      // trickle while tapering\nvar START_MV = 3430;   // begin reducing current\nvar END_MV   = 3500;   // reach MIN_AMPS\n\nvar maxMV = Math.round(msg.payload * 1000);\nvar soc = flow.get(\"soc\");\n\nvar limit;\nif (maxMV <= START_MV) {\n    limit = MAX_AMPS;\n} else if (maxMV >= END_MV) {\n    limit = MIN_AMPS;\n} else {\n    var frac = (maxMV - START_MV) / (END_MV - START_MV);\n    limit = Math.round(MAX_AMPS - frac * (MAX_AMPS - MIN_AMPS));\n}\n\nvar tapering = limit < MAX_AMPS;\nvar label = maxMV + \"mV soc=\" + (soc != null ? soc : \"?\") + \"% \\u2192 \" + limit + \"A\";\nnode.status({\n    fill: tapering ? \"yellow\" : \"green\",\n    shape: tapering ? \"ring\" : \"dot\",\n    text: label\n});\n\nreturn [\n    { payload: limit },\n    { payload: label + (tapering ? \" TAPERING\" : \"\") }\n];",
    "outputs": 2,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 240,
    "wires": [["dvcc-rbe"], ["dvcc-debug-all"]],
    "outputLabels": ["limit", "status"]
  },
